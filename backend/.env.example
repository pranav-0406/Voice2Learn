# Comma-separated origins allowed to call the local API.
VOICE2LEARN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional SQLite file location. The default is backend/data/voice2learn.sqlite3.
# VOICE2LEARN_DATABASE_PATH=C:\path\to\voice2learn.sqlite3

# Optional local educational-answer provider. Install Ollama, then run:
# ollama pull gemma3:4b
# VOICE2LEARN_OLLAMA_BASE_URL=http://127.0.0.1:11434
# VOICE2LEARN_OLLAMA_MODEL=gemma3:4b
# VOICE2LEARN_OLLAMA_TIMEOUT_SECONDS=30

# Speech-to-text provider: "local" (faster-whisper) or "groq" (Groq Cloud Whisper API)
STT_PROVIDER=local
# VOICE2LEARN_STT_PROVIDER=local

# Groq Cloud Speech-to-Text settings (used when STT_PROVIDER=groq)
# PRIVACY NOTICE: Setting STT_PROVIDER=groq sends temporary audio recordings to Groq's
# cloud infrastructure for transcription. To keep all voice processing strictly local
# and on-device (recommended for privacy-sensitive student deployments), use STT_PROVIDER=local.
# GROQ_API_KEY=gsk_your_groq_api_key_here
# GROQ_STT_MODEL=whisper-large-v3-turbo
# Optional accuracy-focused model: GROQ_STT_MODEL=whisper-large-v3
# GROQ_TIMEOUT_SECONDS=30
# VOICE2LEARN_STT_PROMPT="states of matter, evaporation, condensation, quiz, lesson, progress"
# GROQ_AGENT_MODEL=openai/gpt-oss-120b
# GROQ_LLM_MODEL=openai/gpt-oss-20b

# Optional local speech-to-text settings (used when STT_PROVIDER=local). CPU is the safe default.
VOICE2LEARN_STT_MODEL=small
VOICE2LEARN_STT_DEVICE=cpu
VOICE2LEARN_STT_COMPUTE_TYPE=int8
VOICE2LEARN_STT_BEAM_SIZE=1
VOICE2LEARN_STT_VAD_FILTER=true
# 0 lets faster-whisper choose its default; set a positive value after benchmarking.
# VOICE2LEARN_STT_CPU_THREADS=4
VOICE2LEARN_STT_MAX_UPLOAD_BYTES=10485760

